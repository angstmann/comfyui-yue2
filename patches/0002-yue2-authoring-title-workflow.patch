@@ -0,0 +1,50 @@
+"""Simple pass-through text input nodes for YuE2."""
+
+
+class YuE2SongDetails:
+    """Song title and plain-text style editor."""
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {
+            "required": {
+                "title": ("STRING", {
+                    "default": "Untitled Song",
+                }),
+                "style": ("STRING", {
+                    "multiline": True,
+                    "default": "",
+                }),
+            }
+        }
+
+    RETURN_TYPES = ("STRING", "STRING")
+    RETURN_NAMES = ("title", "style")
+    FUNCTION = "output_text"
+    CATEGORY = "YuE2"
+
+    def output_text(self, title, style):
+        return (title, style)
+
+
+class YuE2Lyrics:
+    """Large plain-text lyrics editor. Text is passed through unchanged."""
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {
+            "required": {
+                "lyrics": ("STRING", {
+                    "multiline": True,
+                    "default": "",
+                }),
+            }
+        }
+
+    RETURN_TYPES = ("STRING",)
+    RETURN_NAMES = ("lyrics",)
+    FUNCTION = "output_text"
+    CATEGORY = "YuE2"
+
+    def output_text(self, lyrics):
+        return (lyrics,)
